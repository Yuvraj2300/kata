 import org.springframework.security.core.context.SecurityContext;
 import org.springframework.security.core.context.SecurityContextHolder;

 public class SecurityContextPropagation {
     public static void main(String[] args) {
         SecurityContext securityContext = SecurityContextHolder.getContext();

         new Thread(() -> {
             SecurityContextHolder.setContext(securityContext); // Manually set security context in new thread
             System.out.println("Inside new thread: " + SecurityContextHolder.getContext().getAuthentication());
         }).start();
     }
 }


 How Security Context is Stored
 SecurityContextHolder uses ThreadLocal storage by default, meaning the context is stored per-thread.

 🔹 ThreadLocal Storage
 Every request gets its own thread.
 SecurityContextHolder.getContext() retrieves the context tied to the current thread.
